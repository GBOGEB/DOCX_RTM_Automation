{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Main Pipeline",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/main.py",
            "args": ["--debug"],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Check Files",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/check_all_files.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: ASCII Diagram",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/code/ascii_diagram.py",
            "args": ["output/MASTER_1805_1144.md"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python: Run Code Quality Tools",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/run_code_quality.py",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${input:programPath}",
            "args": [],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        }
    ],
    "inputs": [
        {
          "type": "promptString",
          "id": "programPath",
          "description": "Enter the relative path to the Python file you want to debug (e.g., code/main.py)",
          "default": "code/main.py"
        }
    ]
}