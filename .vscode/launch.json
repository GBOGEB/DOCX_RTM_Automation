{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Main Pipeline",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main_organized.py",
      "args": [
        "--debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Check Files",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main_organized.py",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: ASCII Diagram",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main_organized.py",
      "args": [
        "output/MASTER_1805_1144.md"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: Run Code Quality Tools",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main_organized.py",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python Debugger: Current File with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main_organized.py",
      "args": [],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "type": "promptString",
      "id": "programPath",
      "description": "Enter the relative path to the Python file you want to debug (e.g., code/main.py)",
      "default": "code/main.py"
    }
  ]
}