{
  "name": "@gbogeb/rtm-orchestration",
  "version": "1.0.0",
  "description": "CMB-ready TypeScript orchestration layer for DOCX_RTM_Automation federation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "zod": "^3.23.8",
    "pino": "^9.2.0",
    "pino-http": "^10.2.0",
    "uuid": "^10.0.0",
    "@anthropic-ai/sdk": "^0.24.3",
    "openai": "^4.53.0",
    "@google/generative-ai": "^0.15.0",
    "@octokit/rest": "^21.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.11",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.6.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0"
  }
