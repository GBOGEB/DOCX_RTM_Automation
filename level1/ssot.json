{
  "schema": "gbogeb-level1-ssot/v1",
  "repo": "GBOGEB/DOCX_RTM_Automation",
  "role": "SOURCE_EXTRACTION_RTM_WORKER",
  "default_branch": "main",
  "existing_runtime_refs": ["parser/engine.py", "pipeline/main.py", "orchestration_ts/server.ts", "AGENT_ENTRYPOINT.md"],
  "inputs": ["DOCX", "DOC", "PDF", "TXT", "RTM/OTC/DEL source material"],
